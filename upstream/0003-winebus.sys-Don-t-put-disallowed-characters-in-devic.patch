From b68b571bb0d70022dc634e24bbf557e108b7a792 Mon Sep 17 00:00:00 2001
From: sasayaki <luo17717490371@gmail.com>
Date: Sun, 20 Sep 2026 03:03:41 +0900
Subject: [PATCH] winebus.sys: Don't put disallowed characters in device
 instance IDs.

get_instance_id() interpolates desc.serialnumber straight into the device
instance ID. Backends do not guarantee that string is safe to use there:
the IOHID backend takes it from kIOHIDSerialNumberKey, which for a
Bluetooth device is the MAC address with colons, producing

  HID\VID_054C&PID_0DF2\256&E8:47:3A:B4:1C:0B&3AB41C0B&0&0

A device instance ID may not contain < > : " / \ | ? * or control
characters, so this is malformed. Every input API still reads the device
correctly, which makes the problem easy to miss, but applications that
parse or validate device paths can reject it and then behave as though no
such device is present.

Replace the disallowed characters when building the instance ID.
desc.serialnumber itself is left alone, so the HID serial number string
reported to applications keeps its original form.

Signed-off-by: sasayaki <luo17717490371@gmail.com>
---
 dlls/winebus.sys/main.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/dlls/winebus.sys/main.c b/dlls/winebus.sys/main.c
index 5f46932..4347271 100644
--- a/dlls/winebus.sys/main.c
+++ b/dlls/winebus.sys/main.c
@@ -185,6 +185,17 @@ static DWORD get_device_index(struct device_desc *desc, struct list **before)
     return index;
 }
 
+/* A device instance ID may not contain < > : " / \\ | ? * or control characters.
+ * Serial numbers reaching us from a backend can: the IOHID backend reports the
+ * Bluetooth MAC address with colons, for example. Replace anything disallowed so
+ * applications that validate device paths still see the device. */
+static void sanitise_instance_id(WCHAR *str)
+{
+    static const WCHAR disallowed[] = L"<>:\"/\\|?*";
+    for (; *str; str++)
+        if (*str < 0x20 || wcschr(disallowed, *str)) *str = '_';
+}
+
 static WCHAR *get_instance_id(DEVICE_OBJECT *device)
 {
     struct device_extension *ext = (struct device_extension *)device->DeviceExtension;
@@ -195,6 +206,7 @@ static WCHAR *get_instance_id(DEVICE_OBJECT *device)
     {
         swprintf(dst, len, L"%u&%s&%x&%u&%u", ext->desc.version, ext->desc.serialnumber,
                  ext->desc.uid, ext->index, ext->desc.is_gamepad);
+        sanitise_instance_id(dst);
     }
 
     return dst;
